  "widgets": [
    {
      "key": "box_measurements",
      "label": {
        "en": "Box measurements",
        "fr": "Mesures d'une boîte",
        "de": "Messwerte einer Box",
        "es": "Mediciones de una caja"
      },
      "description": {
        "en": "The live values of a box and the time of its last measurement.",
        "fr": "Les valeurs d'une boîte et l'heure de sa dernière mesure.",
        "de": "Die Werte einer Box und die Zeit ihrer letzten Messung.",
        "es": "Los valores de una caja y la hora de su última medición."
      },
      "icon": "activity",
      "settings": [
        {
          "key": "box",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Box",
            "fr": "Boîte",
            "de": "Box",
            "es": "Caja"
          },
          "description": {
            "en": "Empty: one row per box, with its last measurement.",
            "fr": "Vide : une ligne par boîte, avec sa dernière mesure.",
            "de": "Leer: eine Zeile pro Box, mit ihrer letzten Messung.",
            "es": "Vacío: una fila por caja, con su última medición."
          },
          "required": false
        }
      ]
    }
  ]
