{
  "manifest_version": 1,
  "type": "device",
  "name": "openSenseMap",
  "description": {
    "en": "Measurements of openSenseMap citizen sensor boxes (senseBox), yours or nearby, in Gladys.",
    "fr": "Les mesures des boîtes de capteurs citoyens openSenseMap (senseBox), la vôtre ou voisines.",
    "de": "Messwerte der Bürgersensor-Boxen von openSenseMap (senseBox), deine oder in der Nähe.",
    "es": "Las mediciones de las cajas de sensores ciudadanos openSenseMap (senseBox), la suya o cercanas."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/guim31/gladys-opensensemap:1.0.1",
  "gladys_version": ">=5.2.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-opensensemap/main/cover.png",
  "categories": ["environment"],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "openSenseMap boxes",
        "fr": "Boîtes openSenseMap",
        "de": "openSenseMap-Boxen",
        "es": "Cajas openSenseMap"
      },
      "description": {
        "en": "Read public openSenseMap boxes (no account) by their id, shown in the address of the box on the map. Not affiliated with openSenseMap or senseBox.",
        "fr": "Lisez des boîtes publiques openSenseMap (sans compte) par leur identifiant, visible dans l'adresse de la boîte sur la carte. Non affilié à openSenseMap ni à senseBox.",
        "de": "Lies öffentliche openSenseMap-Boxen (ohne Konto) über ihre ID, die in der Adresse der Box auf der Karte steht. Nicht mit openSenseMap oder senseBox verbunden.",
        "es": "Lea cajas públicas de openSenseMap (sin cuenta) por su identificador, visible en la dirección de la caja en el mapa. Sin afiliación con openSenseMap ni senseBox."
      },
      "links": [
        {
          "url": "https://opensensemap.org",
          "label": {
            "en": "Map of the boxes",
            "fr": "Carte des boîtes",
            "de": "Karte der Boxen",
            "es": "Mapa de las cajas"
          }
        },
        {
          "url": "https://sensebox.de/en/",
          "label": {
            "en": "Build your own senseBox",
            "fr": "Construire sa senseBox",
            "de": "Eigene senseBox bauen",
            "es": "Construir su senseBox"
          }
        }
      ]
    },
    {
      "key": "box_ids",
      "type": "string",
      "label": {
        "en": "Box ids",
        "fr": "Identifiants des boîtes",
        "de": "Box-IDs",
        "es": "Identificadores de las cajas"
      },
      "description": {
        "en": "The ids of the boxes to read (24 characters, or the link of the box), separated by commas, 20 at most. The \"Find boxes near a house\" button below lists those around you.",
        "fr": "Les identifiants des boîtes à lire (24 caractères, ou le lien de la boîte), séparés par des virgules, 20 au plus. Le bouton « Trouver les boîtes autour d'une maison » ci-dessous liste celles qui vous entourent.",
        "de": "Die IDs der zu lesenden Boxen (24 Zeichen, oder der Link der Box), durch Kommas getrennt, höchstens 20. Der Button „Boxen um ein Haus finden“ unten listet die in deiner Nähe auf.",
        "es": "Los identificadores de las cajas que desea leer (24 caracteres, o el enlace de la caja), separados por comas, 20 como máximo. El botón «Buscar cajas alrededor de una casa» más abajo lista las de su zona."
      },
      "placeholder": {
        "en": "e.g. 5cd81adfff898b001ae7c4c6",
        "fr": "ex. 5cd81adfff898b001ae7c4c6",
        "de": "z. B. 5cd81adfff898b001ae7c4c6",
        "es": "p. ej. 5cd81adfff898b001ae7c4c6"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "refresh_minutes",
      "type": "select",
      "label": {
        "en": "Refresh",
        "fr": "Relevé",
        "de": "Abruf",
        "es": "Lectura"
      },
      "description": {
        "en": "How often each box is read. openSenseMap is a free service: 5 minutes is the fastest.",
        "fr": "La fréquence de lecture de chaque boîte. openSenseMap est un service gratuit : 5 minutes au plus vite.",
        "de": "Wie oft jede Box gelesen wird. openSenseMap ist ein kostenloser Dienst: höchstens alle 5 Minuten.",
        "es": "La frecuencia de lectura de cada caja. openSenseMap es un servicio gratuito: 5 minutos como mínimo."
      },
      "required": false,
      "default": "5",
      "options": [
        {
          "value": "5",
          "label": {
            "en": "Every 5 minutes",
            "fr": "Toutes les 5 minutes",
            "de": "Alle 5 Minuten",
            "es": "Cada 5 minutos"
          }
        },
        {
          "value": "10",
          "label": {
            "en": "Every 10 minutes",
            "fr": "Toutes les 10 minutes",
            "de": "Alle 10 Minuten",
            "es": "Cada 10 minutos"
          }
        },
        {
          "value": "15",
          "label": {
            "en": "Every 15 minutes",
            "fr": "Toutes les 15 minutes",
            "de": "Alle 15 Minuten",
            "es": "Cada 15 minutos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "Every 30 minutes",
            "fr": "Toutes les 30 minutes",
            "de": "Alle 30 Minuten",
            "es": "Cada 30 minutos"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language",
        "fr": "Langue",
        "de": "Sprache",
        "es": "Idioma"
      },
      "description": {
        "en": "Language of the feature names (set when a device is added) and of the scene texts.",
        "fr": "Langue des noms de fonctionnalités (fixés à l'ajout d'un appareil) et des textes de scène.",
        "de": "Sprache der Funktionsnamen (beim Hinzufügen eines Geräts festgelegt) und der Szenentexte.",
        "es": "Idioma de los nombres de las funciones (fijados al añadir un dispositivo) y de los textos de escena."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "find_nearby",
      "label": {
        "en": "Find boxes near a house",
        "fr": "Trouver les boîtes autour d'une maison",
        "de": "Boxen um ein Haus finden",
        "es": "Buscar cajas alrededor de una casa"
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "house",
          "type": "select",
          "source": "houses",
          "label": {
            "en": "House",
            "fr": "Maison",
            "de": "Haus",
            "es": "Casa"
          },
          "description": {
            "en": "Its location is set in Settings → Houses. Empty: the first located house.",
            "fr": "Sa position se règle dans Paramètres → Maisons. Vide : la première maison située.",
            "de": "Sein Standort wird unter Einstellungen → Häuser festgelegt. Leer: das erste Haus mit Standort.",
            "es": "Su ubicación se define en Ajustes → Casas. Vacío: la primera casa con ubicación."
          },
          "required": false
        },
        {
          "key": "radius_km",
          "type": "select",
          "label": {
            "en": "Radius",
            "fr": "Rayon",
            "de": "Radius",
            "es": "Radio"
          },
          "description": {
            "en": "Empty: 5 km.",
            "fr": "Vide : 5 km.",
            "de": "Leer: 5 km.",
            "es": "Vacío: 5 km."
          },
          "required": false,
          "options": [
            {
              "value": "1",
              "label": {
                "en": "1 km",
                "fr": "1 km",
                "de": "1 km",
                "es": "1 km"
              }
            },
            {
              "value": "2",
              "label": {
                "en": "2 km",
                "fr": "2 km",
                "de": "2 km",
                "es": "2 km"
              }
            },
            {
              "value": "5",
              "label": {
                "en": "5 km",
                "fr": "5 km",
                "de": "5 km",
                "es": "5 km"
              }
            },
            {
              "value": "10",
              "label": {
                "en": "10 km",
                "fr": "10 km",
                "de": "10 km",
                "es": "10 km"
              }
            },
            {
              "value": "20",
              "label": {
                "en": "20 km",
                "fr": "20 km",
                "de": "20 km",
                "es": "20 km"
              }
            }
          ]
        }
      ]
    },
    {
      "key": "check_boxes",
      "label": {
        "en": "Check the boxes",
        "fr": "Vérifier les boîtes",
        "de": "Boxen prüfen",
        "es": "Comprobar las cajas"
      },
      "timeout_seconds": 120
    }
  ],
  "scene_triggers": [
    {
      "key": "box_offline",
      "label": {
        "en": "Box offline",
        "fr": "Boîte hors ligne",
        "de": "Box offline",
        "es": "Caja sin conexión"
      },
      "description": {
        "en": "A box sent no measurement for the chosen time. Fired once when that time is reached.",
        "fr": "Une boîte n'a envoyé aucune mesure depuis la durée choisie. Déclenché une fois, quand elle est atteinte.",
        "de": "Eine Box hat seit der gewählten Dauer keine Messung gesendet. Einmal ausgelöst, wenn sie erreicht ist.",
        "es": "Una caja no ha enviado ninguna medición durante el tiempo elegido. Se activa una vez, cuando se alcanza."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Box",
            "fr": "Boîte",
            "de": "Box",
            "es": "Caja"
          },
          "description": {
            "en": "Empty: any box.",
            "fr": "Vide : n'importe quelle boîte.",
            "de": "Leer: jede Box.",
            "es": "Vacío: cualquier caja."
          },
          "required": false
        },
        {
          "key": "hours",
          "type": "select",
          "label": {
            "en": "Without measurement for",
            "fr": "Sans mesure depuis",
            "de": "Ohne Messung seit",
            "es": "Sin medición desde hace"
          },
          "required": true,
          "options": [
            {
              "value": "1",
              "label": {
                "en": "1 h",
                "fr": "1 h",
                "de": "1 Std.",
                "es": "1 h"
              }
            },
            {
              "value": "3",
              "label": {
                "en": "3 h",
                "fr": "3 h",
                "de": "3 Std.",
                "es": "3 h"
              }
            },
            {
              "value": "6",
              "label": {
                "en": "6 h",
                "fr": "6 h",
                "de": "6 Std.",
                "es": "6 h"
              }
            },
            {
              "value": "12",
              "label": {
                "en": "12 h",
                "fr": "12 h",
                "de": "12 Std.",
                "es": "12 h"
              }
            },
            {
              "value": "24",
              "label": {
                "en": "24 h",
                "fr": "24 h",
                "de": "24 Std.",
                "es": "24 h"
              }
            },
            {
              "value": "48",
              "label": {
                "en": "48 h",
                "fr": "48 h",
                "de": "48 Std.",
                "es": "48 h"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "box_name",
          "type": "string",
          "label": {
            "en": "Box name",
            "fr": "Nom de la boîte",
            "de": "Name der Box",
            "es": "Nombre de la caja"
          }
        },
        {
          "key": "offline_minutes",
          "type": "number",
          "label": {
            "en": "Minutes without measurement",
            "fr": "Minutes sans mesure",
            "de": "Minuten ohne Messung",
            "es": "Minutos sin medición"
          }
        },
        {
          "key": "last_measurement",
          "type": "string",
          "label": {
            "en": "Last measurement (UTC)",
            "fr": "Dernière mesure (UTC)",
            "de": "Letzte Messung (UTC)",
            "es": "Última medición (UTC)"
          }
        }
      ]
    },
    {
      "key": "box_back_online",
      "label": {
        "en": "Box back online",
        "fr": "Boîte de retour en ligne",
        "de": "Box wieder online",
        "es": "Caja de nuevo en línea"
      },
      "description": {
        "en": "A box measures again after being reported offline.",
        "fr": "Une boîte mesure de nouveau après avoir été signalée hors ligne.",
        "de": "Eine Box misst wieder, nachdem sie als offline gemeldet wurde.",
        "es": "Una caja vuelve a medir tras haber sido señalada sin conexión."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Box",
            "fr": "Boîte",
            "de": "Box",
            "es": "Caja"
          },
          "description": {
            "en": "Empty: any box.",
            "fr": "Vide : n'importe quelle boîte.",
            "de": "Leer: jede Box.",
            "es": "Vacío: cualquier caja."
          },
          "required": false
        }
      ],
      "variables": [
        {
          "key": "box_name",
          "type": "string",
          "label": {
            "en": "Box name",
            "fr": "Nom de la boîte",
            "de": "Name der Box",
            "es": "Nombre de la caja"
          }
        },
        {
          "key": "offline_minutes",
          "type": "number",
          "label": {
            "en": "Minutes without measurement",
            "fr": "Minutes sans mesure",
            "de": "Minuten ohne Messung",
            "es": "Minutos sin medición"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "get_measurements",
      "label": {
        "en": "Get the measurements of a box",
        "fr": "Obtenir les mesures d'une boîte",
        "de": "Messwerte einer Box abrufen",
        "es": "Obtener las mediciones de una caja"
      },
      "description": {
        "en": "Its last values, with a sentence ready for a notification.",
        "fr": "Ses dernières valeurs, avec une phrase prête pour une notification.",
        "de": "Die letzten Werte der Box, mit einem fertigen Satz für eine Benachrichtigung.",
        "es": "Sus últimos valores, con una frase lista para una notificación."
      },
      "timeout_seconds": 10,
      "fields": [
        {
          "key": "box",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Box",
            "fr": "Boîte",
            "de": "Box",
            "es": "Caja"
          },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "summary",
          "type": "string",
          "label": {
            "en": "Summary",
            "fr": "Résumé",
            "de": "Zusammenfassung",
            "es": "Resumen"
          }
        },
        {
          "key": "age_minutes",
          "type": "number",
          "label": {
            "en": "Measurement age (min)",
            "fr": "Âge de la mesure (min)",
            "de": "Alter der Messung (Min.)",
            "es": "Antigüedad de la medición (min)"
