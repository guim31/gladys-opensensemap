          }
        },
        {
          "key": "pm10",
          "type": "number",
          "label": {
            "en": "PM10 (µg/m³)",
            "fr": "PM10 (µg/m³)",
            "de": "PM10 (µg/m³)",
            "es": "PM10 (µg/m³)"
          }
        }
